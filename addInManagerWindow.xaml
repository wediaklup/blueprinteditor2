<?xml version="1.0" encoding="utf-8"?>
<custom:CustomWindow x:Class="S9BEditor.AddInManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:S9BEditor" xmlns:viewModels="clr-namespace:S9BEditor.ViewModels" Style="{StaticResource BPEWindowStyle}" CanMaximize="False" CanMinimize="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Add-in Manager" Height="300" Width="300" HasDialogBackground="True" DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="addInListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate DataType="{x:Type viewModels:VMAddIn}">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Margin="8, 8, 8, 0">Available Add-ins:</TextBlock>
    <ListBox Name="addInListbox" Grid.Row="1" Margin="8, 0, 8, 8" Style="{StaticResource addInListBoxStyle}" ItemsSource="{Binding AddIns}" />
    <TextBlock Grid.Row="2" Margin="8, 0">Description:</TextBlock>
    <TextBox Grid.Row="3" Margin="8, 0, 8, 8" IsReadOnly="True" IsReadOnlyCaretVisible="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="{Binding ElementName=addInListbox, Path=SelectedItem.Description, Mode=OneWay}" />
    <Button Content="OK" Grid.Row="4" Margin="0,0,10,11" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" IsDefault="True" IsCancel="True" />
  </Grid>
</custom:CustomWindow>