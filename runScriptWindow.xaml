<?xml version="1.0" encoding="utf-8"?>
<custom:CustomWindow x:Class="S9BEditor.RunScriptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:S9BEditor" xmlns:viewModels="clr-namespace:S9BEditor.ViewModels" Style="{StaticResource BPEWindowStyle}" CanMaximize="False" CanMinimize="False" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Run Script..." Height="415" Width="516" HasDialogBackground="True" DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="scriptListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="ItemTemplate">
          <Setter.Value>
            <DataTemplate DataType="{x:Type viewModels:VMScript}">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <custom:ScriptPropertyDataTemplateSelector x:Key="scriptPropertyDataTemplateSelector" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0, 8, 0, 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Margin="8,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" />
          <RowDefinition Height="6" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock>Available Scripts:</TextBlock>
          <ListBox Name="scriptsListBox" Grid.Row="1" Style="{StaticResource scriptListBoxStyle}" ItemsSource="{Binding Scripts}" />
        </Grid>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#00000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Grid Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0">Description:</TextBlock>
          <TextBox Grid.Row="1" Margin="0, 0, 0, 8" IsReadOnly="True" IsReadOnlyCaretVisible="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="{Binding ElementName=scriptsListBox, Path=SelectedItem.Description, Mode=OneWay}" />
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="#00000000" />
      <Grid Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0, 0, 8, 0">Arguments:</TextBlock>
        <Border Grid.Row="1" BorderBrush="#FFAEAEAE" BorderThickness="1" Padding="2" Margin="0, 0, 8, 8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl VerticalAlignment="Top" ItemTemplateSelector="{StaticResource scriptPropertyDataTemplateSelector}" ItemsSource="{Binding ElementName=scriptsListBox, Path=SelectedItem.Properties, Mode=OneWay}" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
    <Button Content="Reload All" Grid.Row="4" Margin="0,0,168,6" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" Click="Reload_Click" />
    <Button Content="Run..." Grid.Row="1" Margin="0,0,87,6" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" IsDefault="True" Click="Run_Click" />
    <Button Content="Cancel" Grid.Row="4" Margin="0,0,6,6" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" IsCancel="True" Click="Cancel_Click" />
  </Grid>
</custom:CustomWindow>