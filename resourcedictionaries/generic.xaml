            <ContentPresenter Name="contentPresenter" Grid.Column="1" Grid.Row="1" ContentSource="{TemplateBinding ContentControl.Content}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation To="#FF6CA1FF" Storyboard.TargetName="rect" Storyboard.TargetProperty="Stroke.Color" SpeedRatio="{StaticResource BPEFadeInSpeedRatio}" />
                    <ColorAnimation To="#506CA1FF" Storyboard.TargetName="rectHighlight" Storyboard.TargetProperty="Fill.Color" SpeedRatio="{StaticResource BPEFadeInSpeedRatio}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation To="#00BEA5C0" Storyboard.TargetName="rect" Storyboard.TargetProperty="Stroke.Color" DecelerationRatio="1" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                    <ColorAnimation To="#006CA1FF" Storyboard.TargetName="rectHighlight" Storyboard.TargetProperty="Fill.Color" DecelerationRatio="1" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="False" />
                <Condition Property="ToggleButton.IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard FillBehavior="Stop">
                    <ColorAnimation To="#FF6CA1FF" Storyboard.TargetName="rect" Storyboard.TargetProperty="Stroke.Color" AccelerationRatio="1" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                    <ColorAnimation To="#506CA1FF" Storyboard.TargetName="rectHighlight" Storyboard.TargetProperty="Fill.Color" AccelerationRatio="1" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation To="#FF3C71CF" Storyboard.TargetName="rect" Storyboard.TargetProperty="Stroke.Color" SpeedRatio="{StaticResource BPEFadeInSpeedRatio}" />
                    <ColorAnimation To="#CC6CA1FF" Storyboard.TargetName="rectHighlight" Storyboard.TargetProperty="Fill.Color" SpeedRatio="{StaticResource BPEFadeInSpeedRatio}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
