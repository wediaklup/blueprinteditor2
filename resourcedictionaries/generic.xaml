  <Style x:Key="BPETextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource BPEDefaultContextMenu}" />
  </Style>
  <Style x:Key="{x:Type custom:DataTextBox}" TargetType="{x:Type custom:DataTextBox}" BasedOn="{StaticResource BPETextBoxStyle}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="UIElement.AllowDrop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:DataTextBox}">
          <Border Name="Border" Padding="1" Background="#FFFFFFFF" BorderThickness="1" DataContext="{Binding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer Name="PART_ContentHost" Margin="0" />
              <TextBlock Name="PART_TextVisual" Grid.Column="1" Margin="2, 0, 2, 0" Text="{TemplateBinding custom:DataTextBox.DataUnits}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Border.BorderBrush>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Name="borderBrush" Opacity="0.7">
                <GradientStop x:Name="borderTopGradStop" Color="#00000000" Offset="1" />
                <GradientStop x:Name="borderBottomGradStop" Color="#00000000" Offset="0" />
              </LinearGradientBrush>
            </Border.BorderBrush>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Border.Background">
                <Setter.Value>
                  <SolidColorBrush Color="White" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Border" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="White" />
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="1" SpeedRatio="10" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="0.7" SpeedRatio="10" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="False" />
                <Condition Property="UIElement.IsFocused" Value="False" />
              </MultiTrigger.Conditions>
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
                    <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#FF80B5FF" SpeedRatio="5" />
                    <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#FF3187FF" SpeedRatio="5" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <custom:ResourceAlias x:Key="{x:Type TextBox}" ResourceKey="BPETextBoxStyle" />
  <custom:ResourceAlias x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}" ResourceKey="BPEMenuPopupAnimation" />
  <custom:ResourceAlias x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" ResourceKey="BPETopLevelMenuItemTemplate" />
  <custom:ResourceAlias x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" ResourceKey="BPETopLevelMenuItemTemplate" />
  <custom:ResourceAlias x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" ResourceKey="BPEMenuItemTemplate" />
  <custom:ResourceAlias x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" ResourceKey="BPEMenuItemTemplate" />
  <custom:ResourceAlias x:Key="{x:Static MenuItem.SeparatorStyleKey}" ResourceKey="BPESubMenuSeparatorStyle" />
  <Style x:Key="{x:Type ToolBar}" TargetType="{x:Type ToolBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="{x:Type Button}" BasedOn="{StaticResource BPEFlatButtonStyle}" />
              <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="{x:Type Separator}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate>
                      <Rectangle Fill="#55FFFFFF" Width="1" Margin="4,0,4,0" />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Border Background="#55000000" CornerRadius="4" Margin="2" BorderBrush="#22FFFFFF" BorderThickness="1">
            <ToolBarPanel Name="PART_ToolBarPanel" IsItemsHost="True" Margin="2" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <custom:UriToBitmapImageConverter x:Key="uriToBitmapImageConverter" />
  <Style x:Key="menuItemActionItemStyle" TargetType="{x:Type MenuItem}">
    <Setter Property="MenuItem.Command" Value="{Binding Command}" />
    <Setter Property="Header" Value="{Binding Text}" />
    <Setter Property="MenuItem.InputGestureText" Value="{Binding InputGestureText}" />
    <Setter Property="ItemsSource" Value="{Binding Items}" />
    <Setter Property="MenuItem.Icon" Value="{Binding Path=ImageUri, Converter={StaticResource uriToBitmapImageConverter}}" />
  </Style>
  <Style x:Key="separatorActionItemStyle" TargetType="{x:Type MenuItem}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="30, 4, 4, 4" />
    <Setter Property="IsEnabled" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Fill="#FF444444" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="buttonActionItemStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BPEFlatButtonStyle}">
    <Setter Property="Command" Value="{Binding Command}" />
    <Setter Property="Content" Value="{Binding Path=ImageUri, Converter={StaticResource uriToBitmapImageConverter}}" />
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Text}" />
  </Style>
</ResourceDictionary>