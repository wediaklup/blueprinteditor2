                <SolidColorBrush Color="#00BEA5C0" />
              </Shape.Stroke>
              <Shape.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="#00FFFFFF" Offset="0" />
                  <GradientStop Color="#00D5DBE4" Offset="0.503" />
                  <GradientStop Color="#00BEC5D0" Offset="0.545" />
                  <GradientStop Color="#00ACB3BD" Offset="1" />
                </LinearGradientBrush>
              </Shape.Fill>
            </Rectangle>
            <Rectangle Name="rectHighlight" Grid.RowSpan="3" Grid.ColumnSpan="3" RadiusX="2" RadiusY="2">
              <Shape.Fill>
                <SolidColorBrush Color="#006CA1FF" />
              </Shape.Fill>
