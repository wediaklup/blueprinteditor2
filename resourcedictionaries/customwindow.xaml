<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:S9BEditor;assembly=BlueprintEditor2" xmlns:System="clr-namespace:System;assembly=mscorlib">
  <Color x:Key="BPEBorderDarkColourActive">#FF151515</Color>
  <Color x:Key="BPEBorderLightColourActive">#FF303030</Color>
  <Color x:Key="BPEBorderDarkColourInactive">#FF505050</Color>
  <Color x:Key="BPEBorderLightColourInactive">#FF505050</Color>
  <Color x:Key="BPEBorderColourActiveStroke">#FF597ED1</Color>
  <Color x:Key="BPEBorderColourInactiveStroke">#FF797979</Color>
  <BooleanToVisibilityConverter x:Key="BPEBoolToVis" />
  <Style x:Key="BPEWindowStyle" TargetType="{x:Type custom:CustomWindow}">
    <Style.Resources>
      <ResourceDictionary>
        <System:Double x:Key="ShadowWidth">5</System:Double>
        <GridLength x:Key="ShadowWidthAsGridLength">5</GridLength>
        <Color x:Key="ShadowDark" A="100" />
        <Style x:Key="ShadowWindowStyle" TargetType="{x:Type Window}">
          <Setter Property="Window.AllowsTransparency" Value="True" />
          <Setter Property="Window.WindowStyle" Value="None" />
          <Setter Property="Window.ResizeMode" Value="NoResize" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Window.ShowInTaskbar" Value="False" />
          <Setter Property="Window.ShowActivated" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Window}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ShadowWidthAsGridLength}" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="{StaticResource ShadowWidthAsGridLength}" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource ShadowWidthAsGridLength}" />
                    <RowDefinition />
                    <RowDefinition Height="{StaticResource ShadowWidthAsGridLength}" />
                  </Grid.RowDefinitions>
                  <Rectangle Grid.Column="0" Grid.Row="0">
                    <UIElement.OpacityMask>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="Black" Offset="1" />
                      </LinearGradientBrush>
                    </UIElement.OpacityMask>
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="0" Grid.Row="1">
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="0" Grid.Row="2">
                    <UIElement.OpacityMask>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Transparent" Offset="1" />
                        <GradientStop Color="Black" Offset="0" />
                      </LinearGradientBrush>
                    </UIElement.OpacityMask>
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="1" Grid.Row="2">
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="2" Grid.Row="2">
                    <UIElement.OpacityMask>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Transparent" Offset="1" />
                        <GradientStop Color="Black" Offset="0" />
                      </LinearGradientBrush>
                    </UIElement.OpacityMask>
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="2" Grid.Row="1">
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="2" Grid.Row="0">
                    <UIElement.OpacityMask>
                      <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                        <GradientStop Color="Transparent" Offset="1" />
                        <GradientStop Color="Black" Offset="0" />
                      </LinearGradientBrush>
                    </UIElement.OpacityMask>
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle Grid.Column="1" Grid.Row="0">
                    <Shape.Fill>
                      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Offset="1" Color="{StaticResource ShadowDark}" />
                        <GradientStop Color="#00000000" Offset="0" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:CustomWindow}">
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Key="buttonsBackgroundBrush">
                <GradientStop Color="#77000000" Offset="0" />
                <GradientStop Color="#22000000" Offset="1" />
              </LinearGradientBrush>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Key="buttonSeparatorBrush">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#40FFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
              </LinearGradientBrush>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Grid Name="PART_ClientAreaGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Column="1" Row="1" Background="{StaticResource BPEWindowBackgroundBrush}">
              <Rectangle Fill="{StaticResource BPEWindowBackgroundGridBrush}" />
              <Border Name="PART_dialogBackground" Margin="4" Visibility="Hidden" Style="{StaticResource BPEBorderStyle}" />
              <AdornerDecorator Name="PART_contentAdorner" Margin="0">
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
              </AdornerDecorator>
              <ResizeGrip Name="WindowResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsTabStop="False" Visibility="Collapsed" />
            </Grid>
            <Border Name="PART_TopLeftBorder" Grid.Row="0" Grid.Column="0" BorderThickness="2,2,0,0" CornerRadius="0,0,0,0">
              <Border.BorderBrush>
                <SolidColorBrush x:Name="borderBrushStroke" Color="{StaticResource BPEBorderColourActiveStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Offset="0" x:Name="borderBrushLight" Color="{StaticResource BPEBorderLightColourActive}" />
                  <GradientStop Offset="1" x:Name="borderBrushDark" Color="{StaticResource BPEBorderDarkColourActive}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Name="PART_TopRightBorder" Grid.Row="0" Grid.Column="2" BorderThickness="0,2,2,0" CornerRadius="0,0,0,0">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Offset="0" Color="{Binding Path=Color, ElementName=borderBrushLight}" />
                  <GradientStop Offset="1" Color="{Binding Path=Color, ElementName=borderBrushDark}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Name="PART_TopBorder" Grid.Row="0" Grid.Column="1" BorderThickness="0,2,0,0" Height="{Binding Path=ActualTitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Offset="0" Color="{Binding Path=Color, ElementName=borderBrushLight}" />
                  <GradientStop Offset="1" Color="{Binding Path=Color, ElementName=borderBrushDark}" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid Name="PART_TitleGrid" UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Name="PART_TitleColumnDefinition" Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="PART_TitleTextBlock" Text="{TemplateBinding Window.Title}" VerticalAlignment="Center" Margin="{TemplateBinding custom:CustomWindow.CaptionMargin}" Foreground="#FFFFFFFF" FontSize="14" Grid.Column="1" TextTrimming="CharacterEllipsis" TextAlignment="Center" Effect="{StaticResource BPETitleDropShadowEffect}" />
                <Rectangle Height="20" Grid.Column="2" Grid.ColumnSpan="3" RadiusX="2" RadiusY="2" Fill="{StaticResource buttonsBackgroundBrush}" />
                <Button Name="PART_MinimizeButton" Width="20" Height="20" Grid.Column="2" Focusable="False" custom:CustomWindow.IsNonClientElement="True" Style="{StaticResource BPEFlatButtonStyle}">
                  <Path SnapsToDevicePixels="True" Data="M0,8 L10,8" Stroke="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" StrokeThickness="2" Effect="{StaticResource BPETitleDropShadowEffect}" />
                </Button>
                <Rectangle Grid.Column="3" Height="20" Width="1" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="{StaticResource buttonSeparatorBrush}" Visibility="{Binding Visibility, ElementName=PART_MinimizeButton}" />
                <Button Name="PART_MaximizeButton" Width="20" Height="20" Grid.Column="3" Focusable="False" custom:CustomWindow.IsNonClientElement="True" Style="{StaticResource BPEFlatButtonStyle}">
                  <Path SnapsToDevicePixels="True" Data="M1,9 L9,9 L9,2 L1,2" Stroke="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" StrokeThickness="2" Effect="{StaticResource BPETitleDropShadowEffect}" />
                </Button>
                <Rectangle Grid.Column="4" Height="20" Width="1" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="{StaticResource buttonSeparatorBrush}" Visibility="{Binding Visibility, ElementName=PART_MaximizeButton}" />
                <Button Name="PART_CloseButton" Width="40" Height="20" Grid.Column="4" Focusable="False" custom:CustomWindow.IsNonClientElement="True" Style="{StaticResource BPEFlatButtonStyle}">
                  <Path SnapsToDevicePixels="True" Data="M1,9 L9,1 M1,1 L9,9" Stroke="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10" StrokeThickness="2" Effect="{StaticResource BPETitleDropShadowEffect}" />
                </Button>
              </Grid>
            </Border>
            <Border Name="PART_LeftBorder" Grid.Row="1" Grid.Column="0" BorderThickness="2,0,0,0" Width="{Binding Path=ActualBorderWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushDark}" />
              </Border.Background>
            </Border>
            <Border Name="PART_RightBorder" Grid.Row="1" Grid.Column="2" BorderThickness="0,0,2,0" Width="{Binding Path=ActualBorderWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushDark}" />
              </Border.Background>
            </Border>
            <Border Name="PART_BottomLeftBorder" Grid.Row="2" Grid.Column="0" BorderThickness="2,0,0,2" CornerRadius="0,0,0,0">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushDark}" />
              </Border.Background>
            </Border>
            <Border Name="PART_BottomRightBorder" Grid.Row="2" Grid.Column="2" BorderThickness="0,0,2,2" CornerRadius="0,0,0,0">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushDark}" />
              </Border.Background>
            </Border>
            <Border Name="PART_BottomBorder" Grid.Row="2" Grid.Column="1" BorderThickness="0,0,0,2" Height="{Binding Path=ActualBorderHeight, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.BorderBrush>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushStroke}" />
              </Border.BorderBrush>
              <Border.Background>
                <SolidColorBrush Color="{Binding Path=Color, ElementName=borderBrushDark}" />
              </Border.Background>
            </Border>
            <AdornerDecorator Grid.RowSpan="3" Grid.ColumnSpan="3">
              <ContentPresenter Content="{TemplateBinding custom:CustomWindow.NonClientContent}" ContentTemplate="{TemplateBinding custom:CustomWindow.NonClientContentTemplate}" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
            </AdornerDecorator>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="custom:CustomWindow.HasDialogBackground" Value="True">
              <Setter TargetName="PART_contentAdorner" Property="Margin" Value="6" />
              <Setter TargetName="PART_dialogBackground" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Window.ResizeMode" Value="CanResizeWithGrip" />
                <Condition Property="Window.WindowState" Value="Normal" />
              </MultiTrigger.Conditions>
              <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="Window.WindowState" Value="Maximized">
              <Setter TargetName="PART_TopLeftBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_TopRightBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_LeftBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_RightBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_BottomBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_BottomLeftBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_BottomRightBorder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_TopBorder" Property="Border.BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="custom:NativeWindow.CanMinimize" Value="False">
              <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="custom:NativeWindow.CanMaximize" Value="False">
              <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Window.IsActive" Value="False">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="borderBrushStroke" Storyboard.TargetProperty="Color" DecelerationRatio="1" SpeedRatio="5" To="{StaticResource BPEBorderColourInactiveStroke}" />
                    <ColorAnimation Storyboard.TargetName="borderBrushLight" Storyboard.TargetProperty="Color" DecelerationRatio="1" SpeedRatio="5" To="{StaticResource BPEBorderLightColourInactive}" />
                    <ColorAnimation Storyboard.TargetName="borderBrushDark" Storyboard.TargetProperty="Color" DecelerationRatio="1" SpeedRatio="5" To="{StaticResource BPEBorderDarkColourInactive}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="borderBrushStroke" Storyboard.TargetProperty="Color" DecelerationRatio="1" SpeedRatio="5" To="{StaticResource BPEBorderColourActiveStroke}" />
                    <ColorAnimation Storyboard.TargetName="borderBrushLight" Storyboard.TargetProperty="Color" DecelerationRatio="1" SpeedRatio="5" To="{StaticResource BPEBorderLightColourActive}" />
                    <ColorAnimation Storyboard.TargetName="borderBrushDark" Storyboard.TargetProperty="Color" DecelerationRatio="1" SpeedRatio="5" To="{StaticResource BPEBorderDarkColourActive}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>