<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:custom="clr-namespace:S9BEditor">
  <custom:BooleanToHiddenVisibilityConverter x:Key="boolToVisConverter" />
  <Style x:Key="tabControlItem" TargetType="{x:Type TabItem}">
    <Setter Property="Visibility" Value="{Binding Path=(custom:OverflowPanel.IsOnOverflow), ConverterParameter=!, Converter={StaticResource boolToVisConverter}, RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style x:Key="tabMenuItemStyle" TargetType="{x:Type MenuItem}">
    <Setter Property="Header" Value="{Binding Path=Header}" />
    <Setter Property="MenuItem.Command" Value="{x:Static custom:OverflowTabControl.SelectTabCommand}" />
    <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
  </Style>
  <Style x:Key="{x:Type custom:OverflowTabControl}" TargetType="{x:Type custom:OverflowTabControl}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="custom:OverflowTabControl.TabMenuItemsContainerStyle" Value="{StaticResource tabMenuItemStyle}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource tabControlItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:OverflowTabControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <custom:OverflowPanel x:Name="PART_TabItemsOverflowPanel" IsItemsHost="True" ZIndex="1" CanRearrange="True" OverflowAppendMode="{Binding Path=OverflowAppendMode, RelativeSource={RelativeSource TemplatedParent}}" />
            <custom:DropDownButton x:Name="PART_TabsContextMenuButton" Grid.Column="1" Width="14" Height="14" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Path=DropDown.IsOpen, Mode=OneWay, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding Path=HasItems, RelativeSource={RelativeSource TemplatedParent}}">
              <custom:DropDownButton.DropDown>
                <ContextMenu Name="PART_TabItemsContextMenu" ItemContainerStyle="{StaticResource tabMenuItemStyle}" ItemsSource="{Binding Path=Items, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
              </custom:DropDownButton.DropDown>
            </custom:DropDownButton>
            <Border Grid.Row="1" Grid.ColumnSpan="2" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2">
              <ContentPresenter Margin="4" ContentSource="SelectedContent" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>