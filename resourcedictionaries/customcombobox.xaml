<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:S9BEditor;assembly=BlueprintEditor2" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <ControlTemplate x:Key="BPECustomComboToggleButton" TargetType="{x:Type ToggleButton}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="20" />
      </Grid.ColumnDefinitions>
      <Border Name="Border" Padding="1" BorderThickness="1" Grid.ColumnSpan="2">
        <Border.Background>
          <SolidColorBrush Color="#00000000" x:Name="buttonBackgroundBrush" Opacity="0.35" />
        </Border.Background>
      </Border>
      <Path Name="Arrow" Margin="3" Grid.Column="1" Fill="#FF777777" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,7 L7,7 L7,0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.5" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.35" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="False" />
          <Condition Property="ToggleButton.IsChecked" Value="False" />
        </MultiTrigger.Conditions>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Color" To="#FF80B5FF" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="BPECustomComboToggleButtonEditable" TargetType="{x:Type ToggleButton}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="20" />
      </Grid.ColumnDefinitions>
      <Border Name="Border" Padding="1" BorderThickness="1" Background="#FFFFFFFF" />
      <Border Name="PART_ButtonBorder" Padding="1" BorderThickness="1" Grid.Column="1">
        <Border.Background>
          <SolidColorBrush Color="#00000000" x:Name="buttonBackgroundBrush" Opacity="0.35" />
        </Border.Background>
      </Border>
      <Path Name="Arrow" Margin="3" Grid.Column="1" Fill="#FF777777" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M0,7 L7,7 L7,0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.5" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.35" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="False" />
          <Condition Property="ToggleButton.IsChecked" Value="False" />
        </MultiTrigger.Conditions>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Color" To="#FF80B5FF" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="BPEComboToggleButton" TargetType="{x:Type ToggleButton}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="20" />
      </Grid.ColumnDefinitions>
      <Border Name="Border" Padding="1" BorderThickness="1" Grid.ColumnSpan="2">
        <Border.Background>
          <SolidColorBrush x:Name="buttonBackgroundBrush" Opacity="0.35" Color="{Binding ElementName=borderTopGradStop, Path=Color}" />
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Name="borderBrush" Opacity="0.7">
            <GradientStop x:Name="borderTopGradStop" Color="#00000000" Offset="1" />
            <GradientStop x:Name="borderBottomGradStop" Color="#00000000" Offset="0" />
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
      <Path Name="Arrow" Grid.Column="1" Fill="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="1" SpeedRatio="10" />
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.5" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="0.7" SpeedRatio="10" />
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.35" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="False" />
          <Condition Property="ToggleButton.IsChecked" Value="False" />
        </MultiTrigger.Conditions>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
              <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#FF80B5FF" SpeedRatio="5" />
              <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#FF3187FF" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="BPEComboToggleButtonEditable" TargetType="{x:Type ToggleButton}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="20" />
      </Grid.ColumnDefinitions>
      <Border Name="Border" Padding="1" BorderThickness="1" Background="#FFFFFFFF">
        <Border.BorderBrush>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Name="borderBrush" Opacity="0.7">
            <GradientStop x:Name="borderTopGradStop" Color="#00000000" Offset="1" />
            <GradientStop x:Name="borderBottomGradStop" Color="#00000000" Offset="0" />
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
      <Border Name="PART_ButtonBorder" Padding="1" BorderThickness="0, 1, 1, 1" Grid.Column="1">
        <Border.Background>
          <SolidColorBrush x:Name="buttonBackgroundBrush" Opacity="0.35" Color="{Binding ElementName=borderTopGradStop, Path=Color}" />
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Name="borderBrush2" Opacity="0.7">
            <GradientStop Offset="1" Color="{Binding ElementName=borderTopGradStop, Path=Color}" />
            <GradientStop Offset="0" Color="{Binding ElementName=borderBottomGradStop, Path=Color}" />
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
      <Path Name="Arrow" Grid.Column="1" Fill="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="1" SpeedRatio="10" />
              <DoubleAnimation Storyboard.TargetName="borderBrush2" Storyboard.TargetProperty="Opacity" To="1" SpeedRatio="10" />
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.5" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="0.7" SpeedRatio="10" />
              <DoubleAnimation Storyboard.TargetName="borderBrush2" Storyboard.TargetProperty="Opacity" To="0.7" SpeedRatio="10" />
              <DoubleAnimation Storyboard.TargetName="buttonBackgroundBrush" Storyboard.TargetProperty="Opacity" To="0.35" SpeedRatio="10" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="False" />
          <Condition Property="ToggleButton.IsChecked" Value="False" />
        </MultiTrigger.Conditions>
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
              <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#FF80B5FF" SpeedRatio="5" />
              <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#FF3187FF" SpeedRatio="5" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="BPEComboBoxTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BPETextBoxStyle}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="UIElement.AllowDrop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Border" Padding="1" Background="#FFFFFFFF" BorderThickness="1" DataContext="{Binding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer Name="PART_ContentHost" Margin="0" />
            </Grid>
            <Border.BorderBrush>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Name="borderBrush" Opacity="0.7">
                <GradientStop x:Name="borderTopGradStop" Color="#00000000" Offset="1" />
                <GradientStop x:Name="borderBottomGradStop" Color="#00000000" Offset="0" />
              </LinearGradientBrush>
            </Border.BorderBrush>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Border.Background" Value="{StaticResource DisabledBackgroundBrush}" />
              <Setter TargetName="Border" Property="Border.BorderBrush" Value="{StaticResource DisabledBackgroundBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="1" SpeedRatio="10" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Opacity" To="0.7" SpeedRatio="10" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="False" />
                <Condition Property="UIElement.IsFocused" Value="False" />
              </MultiTrigger.Conditions>
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
                    <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#00000000" SpeedRatio="5" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="borderTopGradStop" Storyboard.TargetProperty="Color" To="#FF80B5FF" SpeedRatio="5" />
                    <ColorAnimation Storyboard.TargetName="borderBottomGradStop" Storyboard.TargetProperty="Color" To="#FF3187FF" SpeedRatio="5" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type custom:CustomComboBox}" TargetType="{x:Type custom:CustomComboBox}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:CustomComboBox}">
          <Grid>
            <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press" Visibility="Visible" Template="{StaticResource BPECustomComboToggleButton}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Name="PART_Text" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="3,1,23,1" Visibility="Visible" Content="{Binding Path=Value, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ContentTemplate="{Binding Path=ValueTemplate, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="#FF808080" />
                    <Setter Property="Background" Value="#00FFFFFF" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </ContentPresenter>
            <custom:DataTextBox x:Name="PART_EditableTextBox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,20,0" Focusable="True" Background="#00FFFFFF" Visibility="Hidden" IsReadOnly="{TemplateBinding custom:CustomComboBox.IsReadOnly}" Text="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding custom:CustomComboBox.IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Grid Name="DropDown" Margin="0,0,8,8" SnapsToDevicePixels="True" Effect="{StaticResource BPEPopupDropShadowEffect}">
                <Border Name="DropDownBorder" Background="#FFEEEEEE" BorderThickness="1" BorderBrush="#FF888888" />
                <ContentPresenter ContentSource="DropDownContent" Margin="2" SnapsToDevicePixels="True" />
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="PART_Popup" Property="Popup.AllowsTransparency" Value="True">
              <Setter TargetName="DropDownBorder" Property="Border.CornerRadius" Value="2" />
            </Trigger>
            <Trigger Property="custom:CustomComboBox.DropDownContent" Value="{x:Null}">
              <Setter TargetName="ToggleButton" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="custom:CustomComboBox.IsEditable" Value="True">
              <Setter TargetName="ToggleButton" Property="Template" Value="{StaticResource BPECustomComboToggleButtonEditable}" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter TargetName="PART_Text" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers />
  </Style>
  <Style x:Key="BPEComboBoxStyle" TargetType="{x:Type ComboBox}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="ToggleButton" Focusable="False" ClickMode="Press" Template="{StaticResource BPEComboToggleButton}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" Margin="3,1,23,1" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBox Name="PART_EditableTextBox" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,20,0" Focusable="True" Background="#00FFFFFF" Visibility="Hidden" IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}" Style="{StaticResource BPEComboBoxTextBoxStyle}" />
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Grid Name="DropDown" Margin="0, 0, 8, 8" SnapsToDevicePixels="True" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" Effect="{StaticResource BPEPopupDropShadowEffect}">
                <Border Name="DropDownBorder" Background="#FFFFFFFF" BorderThickness="1" BorderBrush="#FF555555">
                  <ScrollViewer SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ItemsControl.HasItems" Value="False">
              <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95" />
            </Trigger>
            <Trigger Property="ItemsControl.IsGrouping" Value="True">
              <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Trigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
              <Setter TargetName="ToggleButton" Property="Template" Value="{StaticResource BPEComboToggleButtonEditable}" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers />
  </Style>
</ResourceDictionary>