<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:S9BEditor;assembly=BlueprintEditor2" xmlns:datumTypes="clr-namespace:TypeEdit.Interfaces.Data.Instancing;assembly=TypeEdit.Interfaces" xmlns:viewModels="clr-namespace:S9BEditor.ViewModels;assembly=BlueprintEditor2" xmlns:descriptorTypes="clr-namespace:TypeEdit.Interfaces.Data.Descriptors;assembly=TypeEdit.Interfaces" xmlns:interaction="clr-namespace:S9BEditor.Interaction;assembly=BlueprintEditor2" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <custom:DataEditorIndentToThicknessConverter x:Key="dataEditorItemIndentConverter" IndentWidth="14" />
  <custom:FloatingPointSignChangeConverter x:Key="floatingPointSignChangeConverter" />
  <custom:IsNotNullVisibilityConverter x:Key="isNotNullVisibilityConverter" />
  <custom:GridLengthConverter x:Key="gridLengthConverter" />
  <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
  <ContextMenu x:Key="BPEDataEditorContextMenu">
    <MenuItem Command="ApplicationCommands.Undo" Header="_Undo" />
    <MenuItem Command="ApplicationCommands.Redo" Header="_Redo" />
    <Separator />
    <MenuItem Command="ApplicationCommands.Cut" Header="Cu_t">
      <MenuItem.Icon>
        <Image Source="../Resources/CutHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="ApplicationCommands.Copy" Header="_Copy">
      <MenuItem.Icon>
        <Image Source="../Resources/CopyHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="ApplicationCommands.Paste" Header="_Paste">
      <MenuItem.Icon>
        <Image Source="../Resources/PasteHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="ApplicationCommands.Delete" Header="_Delete">
      <MenuItem.Icon>
        <Image Source="../Resources/DeleteHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Header="Copy as _TypeEdit Path" CommandParameter="{Binding}" Command="{Binding Source={x:Static interaction:DataEditorCommands.CopyAsPath}}" />
    <MenuItem Header="Reset to Default" CommandParameter="{Binding}" Command="{Binding Source={x:Static interaction:DataEditorCommands.ResetToDefault}}" />
  </ContextMenu>
  <ContextMenu x:Key="BPEDataEditorIndexedContextMenu">
    <MenuItem Command="ApplicationCommands.Undo" Header="_Undo" />
    <MenuItem Command="ApplicationCommands.Redo" Header="_Redo" />
    <Separator />
    <MenuItem Command="ApplicationCommands.Cut" Header="Cu_t">
      <MenuItem.Icon>
        <Image Source="../Resources/CutHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="ApplicationCommands.Copy" Header="_Copy">
      <MenuItem.Icon>
        <Image Source="../Resources/CopyHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="ApplicationCommands.Paste" Header="_Paste">
      <MenuItem.Icon>
        <Image Source="../Resources/PasteHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Command="ApplicationCommands.Delete" Header="_Delete">
      <MenuItem.Icon>
        <Image Source="../Resources/DeleteHS.png" MaxWidth="16" MaxHeight="16" />
      </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem Command="interaction:DataEditorCommands.CopyAsPath" Header="Copy as _TypeEdit Path" CommandParameter="{Binding}" />
    <Separator />
    <MenuItem Command="interaction:DataEditorCommands.InsertItemBefore" Header="Insert Item _Before" CommandParameter="{Binding}" />
    <MenuItem Command="interaction:DataEditorCommands.InsertItemAfter" Header="Insert Item _After" CommandParameter="{Binding}" />
  </ContextMenu>
  <Style x:Key="dataEditorItemExpandableButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Width="16" Height="16" Background="#00FFFFFF">
            <Path Name="ExpandPath" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,1,1,1" Fill="{TemplateBinding Control.Foreground}" Data="M4,0 L8,4 L4,8" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="ExpandPath" Property="Path.Data" Value="M8,2 L8,8 L2,8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="dataEditorItemMenuButtonStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Width="16" Height="16" Background="#00FFFFFF">
            <Path Name="MenuPath" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,1,1,1" Fill="{TemplateBinding Control.Foreground}" Data="M0,0 L2,0 L2,2 L0,2 M4,0 L10,0 L10,2 L4,2 M0,4 L2,4 L2,6 L0,6 M4,4 L10,4 L10,6 L4,6 M0,8 L2,8 L2,10 L0,10 M4,8 L10,8 L10,10 L4,10" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="gridTreeViewItemFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border>
            <Rectangle Margin="0,0,0,0" StrokeThickness="5" Stroke="#FF000000" StrokeDashArray="1 2" Opacity="0" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="dataEditorContainerItemStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}">
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="custom:DataEditor.IndentsChildren" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    <Setter Property="VerticalContentAlignment" Value="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource gridTreeViewItemFocusVisual}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource BPEDataEditorContextMenu}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:DataEditorTreeViewItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding Path=ActualNameColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
              <ColumnDefinition Width="{Binding Path=ActualNameColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
              <ColumnDefinition Width="{Binding Path=ActualValueColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
              <ColumnDefinition Width="{Binding Path=ActualValueColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
              <ColumnDefinition Width="{Binding Path=ActualTypeColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
              <ColumnDefinition Width="{Binding Path=ActualTypeColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Name="ItemsHost_Owner" Grid.ColumnSpan="6" Grid.Row="2" Visibility="Collapsed" Width="0">
              <ItemsPresenter Name="ItemsHost" Margin="0,0,0,4" Width="{Binding Path=ActualWidth, ElementName=ItemsHost_Owner}" />
              <Grid Name="PART_FooterGrid" Width="0">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Path=ActualNameColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
                  <ColumnDefinition Width="{Binding Path=ActualNameColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
                  <ColumnDefinition Width="{Binding Path=ActualValueColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
                  <ColumnDefinition Width="{Binding Path=ActualValueColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
                  <ColumnDefinition Width="{Binding Path=ActualTypeColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
                  <ColumnDefinition Width="{Binding Path=ActualTypeColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Name="PART_Footer" ContentSource="Footer" Grid.Row="1" ContentTemplate="{Binding Path=FooterTemplate, RelativeSource={RelativeSource Mode=TemplatedParent}}" Margin="{Binding ConverterParameter='20,0,0,0', RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}" />
              </Grid>
            </StackPanel>
            <Border CornerRadius="{Binding Path=CornerRadius, ElementName=PART_rectHighlight1}" Background="{Binding Path=(custom:DataEditor.ContainerHeaderBackground), RelativeSource={RelativeSource Mode=TemplatedParent}}" Margin="{Binding ConverterParameter='4,4,0,0', RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}">
              <Border Name="PART_rectHighlight1" BorderBrush="#FF5CA1FF" BorderThickness="2,2,0,2" CornerRadius="4,0,0,4" Opacity="0.0" />
            </Border>
            <Border Grid.Column="1" Grid.ColumnSpan="5" Margin="0,4,0,0" Background="{Binding Path=(custom:DataEditor.ContainerHeaderBackground), RelativeSource={RelativeSource Mode=TemplatedParent}}">
              <Border Name="PART_rectHighlight2" BorderBrush="#FF5CA1FF" BorderThickness="0,2,2,2" Opacity="0.0" />
            </Border>
            <Grid Margin="{Binding ConverterParameter='4,4,0,0', RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ToggleButton Name="Expander" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,3,2,3" ClickMode="Press" Style="{StaticResource dataEditorItemExpandableButtonStyle}" Foreground="{Binding Path=(custom:DataEditor.ContainerHeaderForeground), RelativeSource={RelativeSource Mode=TemplatedParent}}" IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <ContentPresenter Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Left" Margin="2,3,2,3" TextBlock.Foreground="{Binding Path=(custom:DataEditor.ContainerHeaderForeground), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
            </Grid>
            <Border Name="PART_itemHeaderSeparatorLeft" Grid.Row="2" Grid.RowSpan="2" Width="10" CornerRadius="0, 0, 4, 4" HorizontalAlignment="Left" Visibility="Collapsed" Background="{Binding Path=(custom:DataEditor.ContainerHeaderBackground), RelativeSource={RelativeSource Mode=TemplatedParent}}" Margin="{Binding ConverterParameter='4,-2,0,0', RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}">
              <Border Name="PART_rectHighlight3" BorderBrush="#FF5CA1FF" BorderThickness="2,0,2,2" CornerRadius="0,0,4,4" Opacity="0.0" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TreeViewItem.IsSelected" Value="True">
              <Setter TargetName="PART_Header" Property="TextBlock.Foreground" Value="{Binding Path=(custom:DataEditor.ContainerHeaderForegroundSelected), RelativeSource={RelativeSource Mode=TemplatedParent}}" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation From="0.6" To="1" DecelerationRatio="1" SpeedRatio="2" Storyboard.TargetName="PART_rectHighlight1" Storyboard.TargetProperty="Opacity" />
                    <DoubleAnimation From="0.6" To="1" DecelerationRatio="1" SpeedRatio="2" Storyboard.TargetName="PART_rectHighlight2" Storyboard.TargetProperty="Opacity" />
                    <DoubleAnimation From="0.6" To="1" DecelerationRatio="1" SpeedRatio="2" Storyboard.TargetName="PART_rectHighlight3" Storyboard.TargetProperty="Opacity" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation To="0" DecelerationRatio="1" Storyboard.TargetName="PART_rectHighlight1" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                    <DoubleAnimation To="0" DecelerationRatio="1" Storyboard.TargetName="PART_rectHighlight2" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                    <DoubleAnimation To="0" DecelerationRatio="1" Storyboard.TargetName="PART_rectHighlight3" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="TreeViewItem.IsExpanded" Value="True" />
                <Condition Property="ItemsControl.HasItems" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_itemHeaderSeparatorLeft" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_rectHighlight1" Property="Border.CornerRadius">
                <Setter.Value>
                  <CornerRadius BottomLeft="0" BottomRight="0" TopLeft="4" TopRight="0" />
                </Setter.Value>
              </Setter>
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost_Owner" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost_Owner" Storyboard.TargetProperty="Width">
                      <DiscreteObjectKeyFrame KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <sys:Double>NaN</sys:Double>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_FooterGrid" Storyboard.TargetProperty="Width">
                      <DiscreteObjectKeyFrame KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <sys:Double>NaN</sys:Double>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost_Owner" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame Value="{x:Static Visibility.Collapsed}" KeyTime="00:00:00" />
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost_Owner" Storyboard.TargetProperty="Width">
                      <DiscreteObjectKeyFrame KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <sys:Double>0</sys:Double>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_FooterGrid" Storyboard.TargetProperty="Width">
                      <DiscreteObjectKeyFrame KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <sys:Double>0</sys:Double>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Width" Value="Auto" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Height" Value="Auto" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <custom:DataEditorItemContentTemplateSelector x:Key="dataEditorItemContentTemplateSelector" />
  <custom:DataEditorItemIndexedContentTemplateSelector x:Key="dataEditorItemIndexedContentTemplateSelector" />
  <custom:DataEditorItemStyleSelector x:Key="dataEditorItemStyleSelector" />
  <custom:DataEditorItemIndexedStyleSelector x:Key="dataEditorItemIndexedStyleSelector" />
  <custom:SingleElementArrayConverter x:Key="singleElementArrayConverter" />
  <custom:BooleanToIntStringConverter x:Key="boolStringConverter" />
  <custom:EBoolToStringConverter x:Key="enumBoolStringConverter" />
  <Style x:Key="hiddenContainerStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:DataEditorTreeViewItem}">
          <ItemsPresenter Name="ItemsHost" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style x:Key="nonHeaderedContainerStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}">
    <Setter Property="FrameworkElement.ContextMenu" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:DataEditorTreeViewItem}">
          <ItemsPresenter Name="ItemsHost" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Focusable" Value="False" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
  </Style>
  <Style x:Key="headeredGroupStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}" BasedOn="{StaticResource dataEditorContainerItemStyle}" />
  <HierarchicalDataTemplate x:Key="groupedPropertiesTemplate" DataType="{x:Type viewModels:VMClassGroup}" ItemTemplateSelector="{StaticResource dataEditorItemContentTemplateSelector}" ItemContainerStyleSelector="{StaticResource dataEditorItemStyleSelector}" ItemsSource="{Binding Properties}">
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding GroupName}" />
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate x:Key="classContentTemplate" DataType="{x:Type viewModels:VMClassTypeDatum}" ItemTemplate="{StaticResource groupedPropertiesTemplate}" ItemContainerStyleSelector="{StaticResource dataEditorItemStyleSelector}" ItemsSource="{Binding Groups}" ItemTemplateSelector="{x:Null}">
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding TypeName}" />
  </HierarchicalDataTemplate>
  <HierarchicalDataTemplate x:Key="indexedClassContainerTemplate" DataType="{x:Type viewModels:VMClassTypeDatum}" ItemTemplateSelector="{StaticResource dataEditorItemContentTemplateSelector}" ItemContainerStyleSelector="{StaticResource dataEditorItemStyleSelector}" ItemsSource="{Binding Converter={StaticResource singleElementArrayConverter}}">
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Path=Name}" />
  </HierarchicalDataTemplate>
  <Style x:Key="headeredIndexedContainerStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}" BasedOn="{StaticResource dataEditorContainerItemStyle}">
    <Setter Property="TreeViewItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="custom:DataEditor.BringIntoView" Value="{Binding BringIntoViewRequested, Mode=TwoWay}" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource BPEDataEditorIndexedContextMenu}" />
    <Setter Property="custom:DataEditor.ContainerHeaderBackground" Value="#FF444444" />
    <Setter Property="custom:DataEditor.ContainerHeaderForeground" Value="#FFFFFFFF" />
    <Setter Property="custom:DataEditor.ContainerHeaderForegroundSelected" Value="#FFFFFFFF" />
  </Style>
  <HierarchicalDataTemplate x:Key="indexedContentTemplate" DataType="{x:Type viewModels:VMIndexedTypeDatum}" ItemTemplateSelector="{StaticResource dataEditorItemIndexedContentTemplateSelector}" ItemContainerStyleSelector="{StaticResource dataEditorItemIndexedStyleSelector}" ItemsSource="{Binding Items}">
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding TypeName}" />
  </HierarchicalDataTemplate>
  <Style x:Key="headeredPropertyContainerStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}" BasedOn="{StaticResource dataEditorContainerItemStyle}">
    <Setter Property="TreeViewItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="custom:DataEditor.BringIntoView" Value="{Binding BringIntoViewRequested, Mode=TwoWay}" />
  </Style>
  <Style x:Key="headeredIndexedPropertyContainerStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}" BasedOn="{StaticResource dataEditorContainerItemStyle}">
    <Setter Property="custom:DataEditorTreeViewItem.Footer" Value="{Binding}" />
    <Setter Property="TreeViewItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="TreeViewItem.IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="custom:DataEditor.BringIntoView" Value="{Binding BringIntoViewRequested, Mode=TwoWay}" />
    <Setter Property="custom:DataEditorTreeViewItem.FooterTemplate">
      <Setter.Value>
        <DataTemplate DataType="{x:Type viewModels:VMProperty}">
          <Button HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False" Command="interaction:DataEditorCommands.AddItem" Style="{StaticResource BPEFlatButtonStyle}" CommandParameter="{Binding PropertyContent}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="../Resources/DataContainer_NewRecordHS.png" MaxWidth="16" MaxHeight="16" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">Add Element...</TextBlock>
            </Grid>
          </Button>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <HierarchicalDataTemplate x:Key="propertyHeaderedTemplate" DataType="{x:Type viewModels:VMProperty}" ItemTemplateSelector="{StaticResource dataEditorItemContentTemplateSelector}" ItemContainerStyleSelector="{StaticResource dataEditorItemStyleSelector}" ItemsSource="{Binding PropertyContent, Converter={StaticResource singleElementArrayConverter}}">
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding PropertyName}" />
  </HierarchicalDataTemplate>
  <Style x:Key="propertyItemStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}">
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource BPEDataEditorContextMenu}" />
    <Setter Property="TreeViewItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="custom:DataEditor.BringIntoView" Value="{Binding BringIntoViewRequested, Mode=TwoWay}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:DataEditorTreeViewItem}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <ContentPresenter Name="PART_ValueContentPresenter" ContentSource="Header" />
            <ItemsPresenter Name="ItemsHost" Grid.Row="1" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="indexedItemStyle" TargetType="{x:Type custom:DataEditorTreeViewItem}" BasedOn="{StaticResource propertyItemStyle}">
    <Setter Property="FrameworkElement.ContextMenu" Value="{StaticResource BPEDataEditorIndexedContextMenu}" />
  </Style>
  <DataTemplate x:Key="propertySimpleTemplate" DataType="{x:Type viewModels:VMProperty}">
    <Grid Visibility="{Binding Path=IsEnabled, Mode=OneWay, Converter={StaticResource booleanToVisibilityConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Path=ActualNameColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualNameColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualValueColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualValueColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualTypeColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualTypeColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition Height="1" />
      </Grid.RowDefinitions>
      <Grid RowSpan="2" Background="#00FFFFFF" Margin="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}">
        <Border Name="Bd" SnapsToDevicePixels="True" Background="#FFA3CCFF" Opacity="0.0" />
        <TextBlock Name="PART_propName" Foreground="#FF000000" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0" Text="{Binding PropertyName}" />
      </Grid>
      <Grid Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter Name="PART_value" ContentTemplateSelector="{StaticResource dataEditorItemContentTemplateSelector}" Content="{Binding PropertyContent}" />
        <Button Name="PART_FileIdButton" Grid.Column="1" Height="20" ToolTip="Open File" Command="interaction:DataEditorCommands.OpenFile" Focusable="False" Style="{StaticResource BPEFlatButtonStyle}" Width="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}" Visibility="{Binding IsFileID, Converter={StaticResource booleanToVisibilityConverter}}" CommandParameter="{Binding}">
          <Image Source="../Resources/openHS.png" MaxWidth="16" MaxHeight="16" />
        </Button>
      </Grid>
      <Grid Name="PART_additionalInfo" Row="1" Column="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="PART_minText" Grid.Column="0" Background="#FFE5E5E5" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Padding="2">
          <Run Text="Min:" /> <Run FontWeight="Bold" Text="{Binding Minimum}" /></TextBlock>
        <TextBlock Name="PART_maxText" Grid.Column="1" Background="#FFE5E5E5" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Padding="2">
          <Run Text="Max:" /> <Run FontWeight="Bold" Text="{Binding Maximum}" /></TextBlock>
        <TextBlock Name="PART_defText" Grid.Column="2" Background="#FFE5E5E5" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Padding="2">
          <Run Text="Def:" /> <Run FontWeight="Bold" Text="{Binding Default}" /></TextBlock>
      </Grid>
      <ContentPresenter Name="PART_typeColumnHeader2" Grid.RowSpan="2" Grid.Column="4" Margin="2,0" VerticalAlignment="Center" Content="{Binding PropertyType}" />
      <Rectangle Grid.Row="2" Margin="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}" Fill="{Binding Path=GridLineBrush, RelativeSource={RelativeSource FindAncestor, AncestorType=custom:DataEditor}}" />
      <Rectangle Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Fill="{Binding Path=GridLineBrush, RelativeSource={RelativeSource FindAncestor, AncestorType=custom:DataEditor}}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="False" Binding="{Binding IsEnabled}">
        <DataTrigger.Setters>
          <Setter TargetName="PART_propName" Property="TextBlock.Foreground" Value="{StaticResource DisabledForegroundBrush}" />
        </DataTrigger.Setters>
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation To="1" DecelerationRatio="1" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeInSpeedRatio}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation To="0" DecelerationRatio="1" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </DataTrigger>
      <DataTrigger Value="false" Binding="{Binding Path=TypeColumnVisible, RelativeSource={RelativeSource FindAncestor, AncestorType=custom:DataEditor}}">
        <Setter TargetName="PART_typeColumnHeader2" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=Minimum}" Value="{x:Null}">
        <Setter TargetName="PART_minText" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=Maximum}" Value="{x:Null}">
        <Setter TargetName="PART_maxText" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=Default}" Value="{x:Null}">
        <Setter TargetName="PART_defText" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="indexedDatumItemTemplate" DataType="{x:Type viewModels:VMTypeDatumBase}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Path=ActualNameColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualNameColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualValueColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualValueColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualTypeColumnWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="{Binding Path=ActualTypeColumnSeparatorWidth, Mode=OneWay, RelativeSource={RelativeSource AncestorType=custom:DataEditor}}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="1" />
      </Grid.RowDefinitions>
      <Grid Background="#00FFFFFF" Margin="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}">
        <Border Name="Bd" SnapsToDevicePixels="True" Background="#FFA3CCFF" Opacity="0.0" />
        <ContentPresenter VerticalAlignment="Center" Margin="2,0" Content="{Binding Name}" />
      </Grid>
      <ContentPresenter Name="PART_value" Grid.Column="2" ContentTemplateSelector="{StaticResource dataEditorItemContentTemplateSelector}" Content="{Binding}" />
      <ContentPresenter Name="PART_typeColumnHeader2" Grid.Column="4" Margin="2,0" VerticalAlignment="Center" Content="{Binding TypeName}" />
      <Rectangle Grid.Row="1" Margin="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem}, Converter={StaticResource dataEditorItemIndentConverter}}" Fill="{Binding Path=GridLineBrush, RelativeSource={RelativeSource FindAncestor, AncestorType=custom:DataEditor}}" />
      <Rectangle Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Fill="{Binding Path=GridLineBrush, RelativeSource={RelativeSource FindAncestor, AncestorType=custom:DataEditor}}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="True" Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation To="1" DecelerationRatio="1" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeInSpeedRatio}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation To="0" DecelerationRatio="1" Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" SpeedRatio="{StaticResource BPEFadeOutSpeedRatio}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </DataTrigger>
      <DataTrigger Value="false" Binding="{Binding Path=TypeColumnVisible, RelativeSource={RelativeSource FindAncestor, AncestorType=custom:DataEditor}}">
        <Setter TargetName="PART_typeColumnHeader2" Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="stringPrimitiveEditor" DataType="{x:Type viewModels:VMPrimitiveTypeDatum}">
    <custom:DataTextBox Text="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DataUnits="{Binding Path=Units}" />
  </DataTemplate>
  <DataTemplate x:Key="boolPrimitiveEditor" DataType="{x:Type viewModels:VMPrimitiveTypeDatum}">
    <CheckBox Margin="4" IsChecked="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource boolStringConverter}}" />
  </DataTemplate>
  <DataTemplate x:Key="boolEnumEditor" DataType="{x:Type viewModels:VMEnumTypeDatum}">
    <CheckBox Margin="4" IsChecked="{Binding Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource enumBoolStringConverter}}" />
  </DataTemplate>
  <DataTemplate x:Key="enumEditor" DataType="{x:Type viewModels:VMEnumTypeDatum}">
    <ComboBox DisplayMemberPath="Value" Style="{StaticResource BPEComboBoxStyle}" ItemsSource="{Binding Path=PossibleValues}" SelectedItem="{Binding Path=SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemTemplateSelector="{x:Null}" ItemContainerStyleSelector="{x:Null}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:VMEnumItem}}" DataType="{x:Type viewModels:VMEnumItem}">
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </DataTemplate>
  <DataTemplate x:Key="referenceEditor" DataType="{x:Type viewModels:VMReferenceTypeDatum}">
    <ComboBox DisplayMemberPath="Name" Style="{StaticResource BPEComboBoxStyle}" ItemsSource="{Binding Path=PossibleReferences}" SelectedItem="{Binding Path=SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:Key="{DataTemplateKey {x:Type viewModels:VMReferenceItem}}" DataType="{x:Type viewModels:VMReferenceItem}">
          <TextBlock Name="PART_TextBlock" Foreground="#FF000000" Text="{Binding Name}" />
          <DataTemplate.Triggers>
            <DataTrigger Value="False" Binding="{Binding HasName}">
              <Setter TargetName="PART_TextBlock" Property="TextBlock.Foreground" Value="#FF808080" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ComboBox>
  </DataTemplate>
  <DataTemplate x:Key="customDropDownEditor" DataType="{x:Type viewModels:VMCustomDatumEditor}">
    <custom:CustomComboBox Value="{Binding Path=Value, Mode=TwoWay}" IsEditable="{Binding Path=IsValueEditable, Mode=OneWay}" DropDownContent="{Binding Path=Content, Mode=OneWay}" />
  </DataTemplate>
  <DataTemplate x:Key="customChildWindowEditor" DataType="{x:Type viewModels:VMCustomDatumEditor}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <custom:CustomComboBox Value="{Binding Path=Value, Mode=TwoWay}" IsEditable="{Binding Path=IsValueEditable, Mode=OneWay}" />
      <Button Grid.Column="1" Height="20" ToolTip="Edit" Command="interaction:DataEditorCommands.OpenChildEditWindow" Focusable="False" Style="{StaticResource BPEFlatButtonStyle}" Width="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}" CommandParameter="{Binding}">
        <TextBlock HorizontalAlignment="Center">...</TextBlock>
      </Button>
    </Grid>
  </DataTemplate>
  <Style x:Key="{x:Type custom:DataEditor}" TargetType="{x:Type custom:DataEditor}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type custom:DataEditor}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="1" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ScrollViewer Name="PART_columnHeadersScrollViewer" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" KeyboardNavigation.TabNavigation="None" Focusable="False">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Path=NameColumnWidth, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource gridLengthConverter}}" />
                  <ColumnDefinition Width="{Binding Path=NameColumnSeparatorWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ColumnDefinition Width="{Binding Path=ValueColumnWidth, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource gridLengthConverter}}" />
                  <ColumnDefinition Width="{Binding Path=ValueColumnSeparatorWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ColumnDefinition Name="PART_typeColumnDefinition" Width="{Binding Path=TypeColumnWidth, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource gridLengthConverter}}" />
                  <ColumnDefinition Name="PART_typeSeparatorColumnDefinition" Width="{Binding Path=TypeColumnSeparatorWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.ColumnSpan="8">
                  <Shape.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                      <GradientStop Color="#1DFFFFFF" Offset="0" />
                      <GradientStop Color="#245D5D5D" Offset="0.387" />
                      <GradientStop Color="#2B000000" Offset="1" />
                      <GradientStop Color="#4E3C3C3C" Offset="0.928" />
                    </LinearGradientBrush>
                  </Shape.Fill>
                </Rectangle>
                <TextBlock Grid.Column="0" Text="Name" Margin="4,0,0,0" />
                <Rectangle Grid.Column="1" Margin="0, 2, 0, 2" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" />
                <TextBlock Grid.Column="2" Text="Value" Margin="4,0,0,0" />
                <Rectangle Grid.Column="3" Margin="0, 2, 0, 2" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" />
                <TextBlock Name="PART_typeColumnHeader" Grid.Column="4" Text="Type" Margin="4,0,0,0" />
                <Rectangle Grid.Column="5" Margin="0, 2, 0, 2" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" Visibility="{Binding ElementName=PART_typeColumnHeader, Path=Visibility, Mode=OneWay}" />
                <GridSplitter Width="9" Margin="0, 0, -5, 0">
                  <Control.Background>
                    <SolidColorBrush />
                  </Control.Background>
                </GridSplitter>
                <GridSplitter Width="9" Margin="0, 0, -5, 0" Grid.Column="2">
                  <Control.Background>
                    <SolidColorBrush />
                  </Control.Background>
                </GridSplitter>
                <GridSplitter Width="9" Margin="0, 0, -5, 0" Grid.Column="4" Visibility="{Binding ElementName=PART_typeColumnHeader, Path=Visibility, Mode=OneWay}">
                  <Control.Background>
                    <SolidColorBrush />
                  </Control.Background>
                </GridSplitter>
              </Grid>
            </ScrollViewer>
            <Rectangle Grid.Row="1" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" />
            <ScrollViewer Name="PART_scrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
              <Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Path=ActualNameColumnWidth, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition Width="{Binding Path=ActualNameColumnSeparatorWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition Width="{Binding Path=ActualValueColumnWidth, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition Width="{Binding Path=ActualValueColumnSeparatorWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition Width="{Binding Path=ActualTypeColumnWidth, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition Width="{Binding Path=ActualTypeColumnSeparatorWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Column="0" Fill="{TemplateBinding custom:DataEditor.NameColumnBrush}" />
                  <Rectangle Grid.Column="1" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" />
                  <Rectangle Grid.Column="2" Fill="{TemplateBinding custom:DataEditor.ValueColumnBrush}" />
                  <Rectangle Grid.Column="3" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" />
                  <Rectangle Grid.Column="4" Fill="{TemplateBinding custom:DataEditor.TypeColumnBrush}" />
                  <Rectangle Grid.Column="5" Fill="{TemplateBinding custom:DataEditor.GridLineBrush}" />
                </Grid>
                <custom:DataEditorTreeView x:Name="PART_treeView" KeyboardNavigation.TabNavigation="Cycle" IsTabStop="False" ItemTemplate="{StaticResource classContentTemplate}" ItemContainerStyle="{StaticResource nonHeaderedContainerStyle}" ItemsSource="{Binding Path=Items, RelativeSource={RelativeSource TemplatedParent}}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TreeView}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate>
                            <ItemsPresenter Name="ItemsHost" />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </FrameworkElement.Style>
                </custom:DataEditorTreeView>
              </Grid>
            </ScrollViewer>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="custom:DataEditor.TypeColumnVisible" Value="False">
              <Setter TargetName="PART_typeColumnHeader" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_typeColumnDefinition" Property="ColumnDefinition.Width" Value="0" />
              <Setter TargetName="PART_typeSeparatorColumnDefinition" Property="ColumnDefinition.Width" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>