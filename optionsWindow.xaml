<?xml version="1.0" encoding="utf-8"?>
<custom:CustomWindow x:Class="S9BEditor.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="clr-namespace:S9BEditor" xmlns:p="clr-namespace:S9BEditor.Properties" xmlns:sys="clr-namespace:System;assembly=mscorlib" Title="Options" Height="344" Width="360" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource BPEWindowStyle}" CanMaximize="False" CanMinimize="False" HasDialogBackground="True">
  <Grid>
    <Button Name="button2" Content="Cancel" Height="23" HorizontalAlignment="Right" Margin="0,0,6,6" VerticalAlignment="Bottom" Width="75" IsCancel="True" />
    <Button Name="button3" Content="OK" Height="23" HorizontalAlignment="Right" Margin="0,0,87,6" VerticalAlignment="Bottom" Width="75" IsDefault="True" Click="button3_Click" />
    <TabControl Name="tabControl1" Margin="0,0,0,35">
      <TabItem Name="tabItem1" Header="General">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="RailWorks Folder:" VerticalAlignment="Center" Margin="4,4,4,0" />
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Name="tbDeploymentPath" Margin="4,4,4,0" VerticalAlignment="Center" Text="{Binding Source={x:Static p:Settings.Default}, Path=DeploymentFolder, UpdateSourceTrigger=Explicit}" />
            <Button Grid.Column="1" Content="..." VerticalAlignment="Center" Margin="0,4,4,0" Width="23" Click="button1_Click" />
          </Grid>
          <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="4,0,4,0" Text="{Binding Source={x:Static custom:AppServices.ResourceManager}, Path=DeploymentPath, StringFormat=Current: {0}}" />
          <TextBlock Grid.Row="3" Text="(Leave blank for default directory)" VerticalAlignment="Center" Margin="8,0,4,0" FontStyle="Italic" />
          <TextBlock Grid.Row="4" Text="Maximum Thread Count:" VerticalAlignment="Center" Margin="4,16,4,0" />
          <Grid Row="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBox Name="tbThreadCount" Margin="4" Width="50" Text="{Binding Source={x:Static p:Settings.Default}, Path=ThreadCount, UpdateSourceTrigger=Explicit}" TextChanged="tbThreadCount_TextChanged" />
            <Label Grid.Column="1" Content="Recommended: " Padding="0" VerticalAlignment="Center" />
            <Label Grid.Column="2" Content="{x:Static sys:Environment.ProcessorCount}" Padding="0" VerticalAlignment="Center" />
          </Grid>
          <CheckBox Name="chkSysSettingsFormat" Grid.Row="6" Content="Use system settings for data entry formats*" Margin="4,16,4,0" VerticalAlignment="Top" IsChecked="{Binding Source={x:Static p:Settings.Default}, Path=UseSystemDataFormat, UpdateSourceTrigger=Explicit}" />
          <Label Grid.Row="8" Content="*(changes will not take effect until the program is restarted)" Padding="0" Margin="8,0,4,0" FontStyle="Italic" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Stretch" />
        </Grid>
      </TabItem>
      <TabItem Name="tabItem2" Header="Type Editor">
        <Grid>
          <CheckBox Name="chkAdvancedEditor" Content="Advanced View" Height="16" HorizontalAlignment="Left" Margin="6,6,0,0" VerticalAlignment="Top" IsChecked="{Binding Source={x:Static p:Settings.Default}, Path=AdvancedDataEditorView, UpdateSourceTrigger=Explicit}" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</custom:CustomWindow>